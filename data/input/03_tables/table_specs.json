        {"name": "age_group", "type": "STRING", "ko": "연령대", "en": "Age group"},
        {"name": "device_id", "type": "STRING", "ko": "개통 단말기 ID (FK)", "en": "Activated device ID (FK)"},
        {"name": "plan_id", "type": "STRING", "ko": "가입 요금제 ID (FK)", "en": "Subscribed plan ID (FK)"},
        {"name": "contract_type", "type": "STRING", "ko": "약정 유형 (PUBLIC_SUBSIDY · SELECTIVE_25PCT)", "en": "Contract type (PUBLIC_SUBSIDY · SELECTIVE_25PCT)"},
