        {"name": "base_subsidy_krw", "type": "INTEGER", "ko": "공시지원금 (원)", "en": "Public subsidy (KRW)"},
        {"name": "additional_subsidy_cap_krw", "type": "INTEGER", "ko": "유통망 추가지원금 상한 (원)", "en": "Retail additional subsidy cap (KRW)"},
        {"name": "mandatory_retention_days", "type": "INTEGER", "ko": "의무유지 기간 (일)", "en": "Commitment period (days)"},
        {"name": "effective_from", "type": "STRING", "ko": "시행 시작일", "en": "Effective from"},
        {"name": "provenance", "type": "STRING", "ko": "데이터 출처 등급", "en": "Data provenance tier"},
        {"name": "source_ref", "type": "STRING", "ko": "원천 파일 · 참조 경로", "en": "Source file or reference"},
        {"name": "effective_to", "type": "STRING", "ko": "시행 종료일", "en": "Effective to"},
        {"name": "total_subsidy_krw", "type": "INTEGER", "ko": "총 지원금 (공시 + 추가, 원)", "en": "Total subsidy (public + retail, KRW)"}
      ]
    },
    "tb_customer_contract": {
      "group": "p2_source", "kind": "node", "label": "CustomerContractNode", "key": ["contract_id"], "csv": "customer_contracts.csv",
      "description_ko": "비식별 고객 약정 원장", "description_en": "De-identified customer contract ledger",
