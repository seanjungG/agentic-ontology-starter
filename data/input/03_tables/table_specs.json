{
  "version": "v4.0.0-GOAL-223",
  "_readme_ko": "BigQuery 적재 스키마 · 컬럼 설명(ko/en) · 그래프 요소 정의. 기존 컬럼과 타입은 그대로 두고(노트북 호환) *_ko / *_en 라벨 컬럼만 더합니다.",
  "_readme_en": "BigQuery load schema, column descriptions (ko/en) and graph element definitions. Legacy columns and types are kept (notebook compatibility); only *_ko / *_en label columns are added.",
  "groups": {
    "p2_source": {"path": "P2", "ko": "원천 테이블 6종", "en": "6 source tables"},
    "p2_edges": {"path": "P2", "ko": "파생 엣지 테이블 3종", "en": "3 derived edge tables"},
    "p3_nodes": {"path": "P3", "ko": "위키 · 규칙 노드 테이블 4종", "en": "4 wiki / rule node tables"},
    "p3_edges": {"path": "P3", "ko": "브릿지 엣지 테이블 4종", "en": "4 bridge edge tables"}
  },
  "tables": {
    "tb_device_master": {
      "group": "p2_source", "kind": "node", "label": "DeviceNode", "key": ["device_id"], "csv": "devices.csv",
      "description_ko": "단말기 출고가 마스터 원장", "description_en": "Device factory price master ledger",
      "columns": [
        {"name": "device_id", "type": "STRING", "ko": "단말기 고유 ID (PK)", "en": "Device ID (PK)"},
        {"name": "device_name", "type": "STRING", "ko": "단말기 모델명 (모델 + 용량)", "en": "Device model name (model + storage)"},
        {"name": "manufacturer", "type": "STRING", "ko": "제조사", "en": "Manufacturer"},
        {"name": "storage_gb", "type": "INTEGER", "ko": "내장 메모리 용량 (GB)", "en": "Storage (GB)"},
        {"name": "factory_price_krw", "type": "INTEGER", "ko": "출고가 (원)", "en": "Factory price (KRW)"},
        {"name": "release_date", "type": "STRING", "ko": "출시일 (YYYY-MM-DD)", "en": "Release date (YYYY-MM-DD)"},
        {"name": "provenance", "type": "STRING", "ko": "데이터 출처 등급 (SYNTHETIC_DEMO 등)", "en": "Data provenance tier (for example SYNTHETIC_DEMO)"},
        {"name": "source_ref", "type": "STRING", "ko": "원천 파일 · 참조 경로", "en": "Source file or reference"},
        {"name": "model_code", "type": "STRING", "ko": "제조사 모델 코드", "en": "Manufacturer model code"}
      ]
    },
    "tb_plan_master": {
      "group": "p2_source", "kind": "node", "label": "PlanNode", "key": ["plan_id"], "csv": "plans.csv",
      "description_ko": "모바일 요금제 마스터 원장", "description_en": "Mobile plan master ledger",
      "columns": [
        {"name": "plan_id", "type": "STRING", "ko": "요금제 고유 ID (PK)", "en": "Plan ID (PK)"},
        {"name": "plan_name", "type": "STRING", "ko": "요금제 공식 명칭", "en": "Official plan name"},
        {"name": "tier_category", "type": "STRING", "ko": "요금제 등급 (5G_HIGH · 5G_MID · BELOW_BASELINE)", "en": "Plan tier (5G_HIGH · 5G_MID · BELOW_BASELINE)"},
        {"name": "monthly_fee_krw", "type": "INTEGER", "ko": "월정액 (원)", "en": "Monthly fee (KRW)"},
        {"name": "min_maintenance_days", "type": "INTEGER", "ko": "공시지원금 의무유지 일수 (대상이 아니면 0)", "en": "Commitment days for public subsidy (0 when not applicable)"},
        {"name": "selective_discount_rate", "type": "FLOAT", "ko": "선택약정 요금할인율", "en": "Selective contract discount rate"},
        {"name": "provenance", "type": "STRING", "ko": "데이터 출처 등급", "en": "Data provenance tier"},
        {"name": "source_ref", "type": "STRING", "ko": "원천 파일 · 참조 경로", "en": "Source file or reference"},
        {"name": "network_type", "type": "STRING", "ko": "망 종류 (5G · LTE)", "en": "Network type (5G · LTE)"},
        {"name": "is_baseline_tier", "type": "BOOLEAN", "ko": "기준 요금제선 이상 여부", "en": "At or above the baseline plan threshold"}
      ]
    },
    "tb_subsidy_policy": {
