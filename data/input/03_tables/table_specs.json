        {"name": "elapsed_days", "type": "INTEGER", "ko": "개통 후 경과일수", "en": "Days elapsed since activation"},
        {"name": "granted_subsidy_krw", "type": "INTEGER", "ko": "지급된 총 지원금 (원)", "en": "Total subsidy granted (KRW)"},
