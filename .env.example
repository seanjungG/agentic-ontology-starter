# Agentic Ontology Starter — environment template (copy to .env; never commit .env)
# All resource ids are env-driven (see src/gcp_client.py · runtime_settings()); step 3 of the wizard can override
# them per browser without changing these server defaults.

# Google Cloud defaults (step 3 prefill)
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=starter_ontology_dw
BQ_LOCATION=asia-northeast3
GCS_WIKI_BUCKET=your-ontology-wiki-bucket
# Optional: Spanner graph refresh in step 4
SPANNER_INSTANCE_ID=starter-spanner
SPANNER_DATABASE_ID=starter_ontology_db
BQ_SPANNER_CONNECTION_ID=spanner_fabric_conn

# Vertex AI (gemini-4-argon runs on location `global`; it needs thinkingLevel, not thinkingBudget)
VERTEX_GEMINI_MODEL=gemini-4-argon
VERTEX_LOCATION=global
VERTEX_THINKING_LEVEL=LOW
VERTEX_BUILD_THINKING_LEVEL=HIGH
VERTEX_TIMEOUT_S=150

# Platform Core MCP (zero-privilege; data tools run with the caller token sent in X-AOS-Access-Token)
CORE_MCP_URL=https://aos-builder-core-mcp-115847445822.asia-northeast3.run.app/mcp
# strict = never bypass the Core MCP (default) · direct = fall back to direct REST calls (development only)
AOS_CORE_MCP_FALLBACK=strict

# Write guard: projects that step 4 may load into (comma-separated, * = any). Default = GCP_PROJECT_ID
STARTER_WRITE_PROJECTS=your-gcp-project-id

PORT=8080
