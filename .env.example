# Agentic Ontology Starter — environment template (copy to .env; never commit .env)
# All resource IDs are env-driven (see src/gcp_client.py · runtime_settings());
# Step 2 in the studio or Step 3 in /wizard can override them per browser without editing server defaults.

# Google Cloud defaults
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=starter_ontology_dw
BQ_LOCATION=asia-northeast3
GCS_WIKI_BUCKET=your-ontology-wiki-bucket

# Semantic Graph defaults (Spanner Graph is default; BigQuery Property Graph stays optional / Lab 3 Context Graph)
AOS_GRAPH_ENGINE=spanner
SPANNER_INSTANCE_ID=starter-spanner
AOS_SPANNER_DATABASE=starter_graph_db
AOS_SPANNER_TTL_DAYS=7
# Optional reference-wizard Spanner refresh settings
SPANNER_DATABASE_ID=starter_ontology_db
BQ_SPANNER_CONNECTION_ID=spanner_fabric_conn

# Vertex AI (gemini-4-argon runs on location `global`; uses thinkingLevel, not thinkingBudget)
VERTEX_GEMINI_MODEL=gemini-4-argon
VERTEX_LOCATION=global
VERTEX_THINKING_LEVEL=MEDIUM
VERTEX_BUILD_THINKING_LEVEL=MEDIUM
VERTEX_TIMEOUT_S=150

# Platform Core MCP (zero-privilege; all GCP operations run strictly with the caller token in X-AOS-Access-Token)
CORE_MCP_URL=https://aos-builder-core-mcp-dasz7pvvua-du.a.run.app/mcp
# strict = never bypass the Core MCP (default) · direct = fall back to direct REST calls (local dev only)
AOS_CORE_MCP_FALLBACK=strict

# Companion links (Starter Notebook Lab & 3-Asset Showcase Hub)
STARTER_NOTEBOOK_URL=https://agentic-ontology-starter-notebook-dasz7pvvua-du.a.run.app/
STARTER_SHOWCASE_URL=https://agentic-ontology-starter-notebook-dasz7pvvua-du.a.run.app/showcase

# Write guard: projects that demo identity may write into (comma-separated, * = any). Default = GCP_PROJECT_ID
STARTER_WRITE_PROJECTS=your-gcp-project-id
# Optional: allowlist pattern for server-side SA impersonation (disabled when empty)
# STARTER_IMPERSONATE_ALLOW=*@your-gcp-project-id.iam.gserviceaccount.com
# Optional: local dev gcloud account override
# GCP_GCLOUD_ACCOUNT=your-account@example.com

# Optional: Unified Admin Core MCP Portal & Metering (/admin, fail-closed until configured)
# Recommended mode: Identity Platform / Firebase Google Sign-In (RS256 ID token + allowlisted emails)
# STARTER_ADMIN_AUTH_MODE=google
# STARTER_ADMIN_FIREBASE_PROJECT=your-auth-project-id
# STARTER_ADMIN_FIREBASE_API_KEY=your-public-web-api-key
# STARTER_ADMIN_EMAILS=admin@example.com
# STARTER_ADMIN_SESSION_SECRET=change-me-to-a-random-32-byte-secret
# AOS_METERING_BQ_TABLE=your-gcp-project-id.aos_metering.core_mcp_usage_events

PORT=8080
